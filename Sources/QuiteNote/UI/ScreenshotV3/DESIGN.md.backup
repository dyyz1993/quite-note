## 3. 状态机设计

### 3.1 状态定义

```swift
/// 截图阶段枚举
enum ScreenshotPhase: Equatable {
    /// 阶段 0: 选区创建
    case selecting

    /// 阶段 1: 选区调整
    case adjusting(selection: CGRect)

    /// 阶段 2: 编辑和标注
    case annotating(selection: CGRect, mode: AnnotationMode)

    /// 阶段 2 的子模式
    enum AnnotationMode: Equatable {
        case editing            // 2A: 标注编辑
        case longScreenshot     // 2B: 长截图
        case recording          // 2C: 录屏
    }
}

/// 选区创建子状态
enum Phase0State {
    case idle                  // 空闲，无操作
    case hovering(window: WindowInfo)  // 悬停在窗口上
    case dragging(start: CGPoint, current: CGPoint)  // 拖拽创建选区
}

/// 选区调整子状态
enum Phase1State {
    case idle                  // 空闲
    case movingSelection(offset: CGSize)  // 移动选区
    case resizing(handle: SelectionHandle, initialRect: CGRect)  // 调整大小
}

/// 标注编辑子状态
enum AnnotationTool {
    case rectangle
    case arrow
    case pen
    case text
    case mosaic
    case spotlight
    case number
}
```

### 3.2 状态转换矩阵

| 当前状态 | 触发事件 | 下一状态 | 动作 |
|----------|----------|----------|------|
| `selecting` | 鼠标悬停窗口 | `selecting` (hovering) | 高亮窗口 |
| `selecting` | 开始拖拽 | `selecting` (dragging) | 绘制临时选区 |
| `selecting` | 拖拽结束 (rect>5) | `adjusting(selection:)` | 确认选区，显示手柄 |
| `selecting` | 点击窗口 | `adjusting(selection:)` | 使用窗口边界作为选区 |
| `selecting` | 点击空白 | `selecting` (idle) | 取消高亮 |
| `selecting` | ESC | 退出截图 | 关闭窗口，重置状态 |
| `adjusting` | 拖拽选区内部 | `adjusting` (moving) | 移动选区 |
| `adjusting` | 拖拽调整手柄 | `adjusting` (resizing) | 调整选区大小 |
| `adjusting` | 点击标注工具按钮 | `annotating(editing)` | 进入标注编辑 |
| `adjusting` | 点击"长图" | `annotating(longScreenshot)` | 进入长截图 |
| `adjusting` | 点击"录屏" | `annotating(recording)` | 进入录屏 |
| `adjusting` | 点击"完成" | 退出截图 | 保存截图，关闭窗口 |
| `adjusting` | 点击"取消" / ESC | `selecting` | 清除选区，返回阶段 0 |
| `adjusting` | 点击空白 | 不可操作 | 忽略事件 |
| `annotating(editing)` | 选择工具 | `annotating(editing)` | 激活工具 |
| `annotating(editing)` | 绘制标注 | `annotating(editing)` | 添加标注元素 |
| `annotating(editing)` | Cmd+Z | `annotating(editing)` | 撤销 |
| `annotating(editing)` | 点击"完成" | 退出截图 | 保存截图，关闭窗口 |
| `annotating(editing)` | 点击"返回" / ESC | `adjusting(selection:)` | 清除标注，返回阶段 1 |
| `annotating(longScreenshot)` | 点击"开始滚动" | `annotating(longScreenshot)` | 开始滚动截图 |
| `annotating(longScreenshot)` | 点击"完成" | 退出截图 | 保存长图，关闭窗口 |
| `annotating(longScreenshot)` | 点击"返回" / ESC | `adjusting(selection:)` | 返回阶段 1 |
| `annotating(recording)` | 点击"开始录制" | `annotating(recording)` | 开始录制 |
| `annotating(recording)` | 点击"停止" | 退出截图 | 保存视频，关闭窗口 |
| `annotating(recording)` | 点击"返回" / ESC | `adjusting(selection:)` | 返回阶段 1 |

### 3.3 状态管理器接口

```swift
/// 截图状态管理器
@MainActor
class ScreenshotStateManager: ObservableObject {
    /// 当前阶段
    @Published var currentPhase: ScreenshotPhase = .selecting

    /// 阶段 0 子状态
    @Published var phase0State: Phase0State = .idle

    /// 阶段 1 子状态
    @Published var phase1State: Phase1State = .idle

    /// 当前选区（所有阶段共享）
    @Published var selection: CGRect?

    /// 所有标注元素（阶段 2A）
    @Published var annotations: [AnnotationElement] = []

    /// 撤销栈（阶段 2A）
    private var undoStack: [[AnnotationElement]] = []

    /// 重做栈（阶段 2A）
    private var redoStack: [[AnnotationElement]] = []

    // MARK: - 状态转换方法

    /// 进入阶段 1
    func moveToPhase1(with selection: CGRect) {
        self.selection = selection
        self.currentPhase = .adjusting(selection: selection)
        self.phase0State = .idle
    }

    /// 返回阶段 0
    func returnToPhase0() {
        self.selection = nil
        self.currentPhase = .selecting
        self.phase1State = .idle
    }

    /// 进入阶段 2
    func moveToPhase2(mode: ScreenshotPhase.AnnotationMode) {
        guard let selection = self.selection else { return }
        self.currentPhase = .annotating(selection: selection, mode: mode)
    }

    /// 返回阶段 1
    func returnToPhase1() {
        guard let selection = self.selection else {
            returnToPhase0()
            return
        }
        self.currentPhase = .adjusting(selection: selection)
        self.annotations = [] // 清除标注
        self.undoStack = []
        self.redoStack = []
    }

    /// 退出截图
    func exit() {
        self.selection = nil
        self.currentPhase = .selecting
        self.phase0State = .idle
        self.phase1State = .idle
        self.annotations = []
        self.undoStack = []
        self.redoStack = []
    }

    // MARK: - 标注操作（阶段 2A）

    func addAnnotation(_ annotation: AnnotationElement) {
        saveStateForUndo()
        annotations.append(annotation)
    }

    func undo() {
        guard !undoStack.isEmpty else { return }
        redoStack.append(annotations)
        annotations = undoStack.removeLast()
    }

    func redo() {
        guard !redoStack.isEmpty else { return }
        saveStateForUndo()
        annotations = redoStack.removeLast()
    }

    private func saveStateForUndo() {
        undoStack.append(annotations)
        if undoStack.count > 50 {
            undoStack.removeFirst()
        }
    }
}
```

