<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quitenote.core</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/quitenote-core</string>
        <string>--database</string>
        <string>/Users/SHARED/Library/Application Support/QuiteNote/ClipboardHistory.sqlite</string>
        <string>--state</string>
        <string>/Users/SHARED/Library/Application Support/QuiteNote/CoreService/state.json</string>
        <string>--interval</string>
        <string>0.5</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
